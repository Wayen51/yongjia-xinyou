# 服务端
# 复制本文件为 .env 后填写。默认 mock 模式保证“无 key 也能演示”。
#
# 接入真实模型（示例：DeepSeek，OpenAI 兼容）：
#   LLM_PROVIDER=deepseek
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=deepseek-chat
#   MOCK_LLM=false
# 其它 OpenAI 兼容服务同样适用：替换 BASE_URL / KEY / MODEL 即可。
LLM_PROVIDER=mock
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-air
WEATHER_API_KEY=
MOCK_LLM=true
DEMO_CONSOLE=true
PORT=3000

# 访问令牌：保护消耗 LLM 的接口（智能伴侣对话 / 视频提示词美化 / AR 剧情生成）。
# 与前端 apps/web/src/api/client.ts 中的 API_TOKEN 保持一致；留空则关闭校验。
CHAT_API_TOKEN=

# 前端（构建时）
VITE_API_BASE=/api
VITE_DEMO_CONSOLE=true
