{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/api/*": ["../web/src/api/*"],
      "@/types/*": ["../web/src/types/*"],
      "@/lib/*": ["../web/src/lib/*"],
      "@/components/*": ["../web/src/components/*"],
      "@/stores/*": ["../web/src/stores/*"],
      "@/views/*": ["../web/src/views/*"],
      "@/styles/*": ["../web/src/styles/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
