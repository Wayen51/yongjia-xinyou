{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // 源码内统一用 .ts/.js 显式扩展名的 ESM 写法（tsx 直接跑源码时必需）。
    // 编译产出时由 rewriteRelativeImportExtensions 把 .ts 改写成 .js。
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
